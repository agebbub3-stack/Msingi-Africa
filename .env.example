# Contact address shown by the editorial and partnership forms.
NEXT_PUBLIC_EDITORIAL_EMAIL=editorial@msingi.africa

# PostgreSQL connection string from your provider (for example Aiven or Supabase).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Optional CA override for other PostgreSQL providers. Public Aiven and
# Supabase root CAs are bundled and selected by hostname. Literal \n sequences
# are supported.
DATABASE_CA_CERT=

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# Public application origin used for OAuth-free auth callbacks and Flutterwave returns.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only. Use a Flutterwave test secret in development.
FLW_SECRET_KEY=
# Set this hash in the Flutterwave webhook dashboard.
FLW_SECRET_HASH=
# Create a monthly USD 5 payment plan in the Flutterwave dashboard and set its ID here.
FLW_PAYMENT_PLAN_ID=

# Configure a verified sender in Resend to send verification and password-reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Msingi Africa <no-reply@msingi.africa>
