# Contact address shown by the editorial and partnership forms.
NEXT_PUBLIC_EDITORIAL_EMAIL=editorial@msingi.africa

# PostgreSQL connection string from your provider (for example Aiven or Supabase).
DATABASE_URL=

# Optional CA certificate for strict PostgreSQL TLS verification.
# Supabase pooler connections use encrypted SSL; configure the database root
# certificate here to also verify the server certificate. Literal \n is supported.
DATABASE_CA_CERT=

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# Public application origin used for OAuth-free auth callbacks and Flutterwave returns.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML tag verification token (the content value only).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools HTML tag verification token (msvalidate.01 content only).
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, digits or hyphens); the public root verification file is /indexnow-key.txt.
# Run: npm run seo:indexnow -- /artigos/example /biografias/example
INDEXNOW_KEY=
INDEXNOW_SITE_URL=https://kioo-africa.vercel.app

# Google Search Console: add this service account as a user of the property with read access.
# Keep the JSON server-side (never use a NEXT_PUBLIC_ variable). Run:
# npm run seo:gsc -- https://kioo-africa.vercel.app/biografias/isaac-nascimento-quarenta
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://kioo-africa.vercel.app/
GOOGLE_SERVICE_ACCOUNT_JSON=

# Server-side only. Use a Flutterwave test secret in development.
FLW_SECRET_KEY=
# Set this hash in the Flutterwave webhook dashboard.
FLW_SECRET_HASH=
# Create a monthly USD 5 payment plan in the Flutterwave dashboard and set its ID here.
FLW_PAYMENT_PLAN_ID=

# Configure a verified sender in Resend to send verification and password-reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kioo Africa <no-reply@msingi.africa>
